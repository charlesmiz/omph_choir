import { initializeApp } from 'firebase/app';
import { getFirestore, doc, getDoc, setDoc } from 'firebase/firestore';

// In-memory active session store
interface SessionData {
  userId: string;
  username?: string;
  userType: 'member' | 'executive';
  fullName: string;
  role?: string;
  positionId?: string;
  permissions?: string[];
  expiresAt: number;
}
const activeSessions = new Map<string, SessionData>();

// Helper: Cryptographic password hashing using Node scrypt
function hashPassword(password: string): string {
  const salt = crypto.randomBytes(16).toString('hex');
  const derivedKey = crypto.scryptSync(password, salt, 64);
  return `${salt}:${derivedKey.toString('hex')}`;
}

function verifyPassword(password: string, storedHash: string): boolean {
  try {
    if (!storedHash || !storedHash.includes(':')) return false;
    const [salt, key] = storedHash.split(':');
    if (!salt || !key) return false;
    const keyBuffer = Buffer.from(key, 'hex');
    const derivedKey = crypto.scryptSync(password, salt, 64);
    return crypto.timingSafeEqual(keyBuffer, derivedKey);
  } catch {
    return false;
  }
}

function generateRandomToken(bytes = 32): string {
  return crypto.randomBytes(bytes).toString('hex');
}

function generateActivationCode(): string {
  const digits = '23456789ABCDEFGHJKLMNPQRSTUVWXYZ';
  let code = 'ACT-';
  for (let i = 0; i < 6; i++) {
    code += digits.charAt(Math.floor(Math.random() * digits.length));
  }
  return code;
}

function generateResetToken(): string {
  const digits = '23456789ABCDEFGHJKLMNPQRSTUVWXYZ';
  let token = 'RST-';
  for (let i = 0; i < 6; i++) {
    token += digits.charAt(Math.floor(Math.random() * digits.length));
  }
  return token;
}

// -------------------------------------------------------------
// Firebase Firestore Client & Cloud Persistence
// -------------------------------------------------------------
const firebaseConfigFile = path.resolve(process.cwd(), 'firebase-applet-config.json');
let firestoreDb: any = null;
let firestoreDatabaseId = '';

if (fs.existsSync(firebaseConfigFile)) {
  try {
    const firebaseConfig = JSON.parse(fs.readFileSync(firebaseConfigFile, 'utf-8'));
    firestoreDatabaseId = firebaseConfig.firestoreDatabaseId || '';
    const fbApp = initializeApp(firebaseConfig, 'omph-backend-service');
    firestoreDb = getFirestore(fbApp, firestoreDatabaseId);
    console.log('[Firestore] Successfully initialized persistent database:', firestoreDatabaseId);
  } catch (err) {
    console.warn('[Firestore] Warning: Could not initialize Firebase SDK:', err);
  }
}

