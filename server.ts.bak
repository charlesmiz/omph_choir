  app.delete('/api/gallery/:id', authenticateToken, async (req: any, res) => {
    if (req.user.userType !== 'executive') {
      return res.status(403).json({ success: false, message: 'Executive authorization required.' });
    }
    const { id } = req.params;
    const data = readData();
    if (!Array.isArray(data.gallery)) data.gallery = [];
    const target = data.gallery.find((p: any) => p.photoId === id);
    data.gallery = data.gallery.filter((p: any) => p.photoId !== id);

    await atomicWriteData(data);
    if (target) {
      await recordAudit({
