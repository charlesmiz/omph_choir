      officialPosition: req.user.role,
      action: 'Upload Media Photo',
      module: 'Media Gallery',
      targetEntity: fullPhoto.title,
      recordId: photoId,
    });

    res.json({ success: true, photo: fullPhoto, gallery: data.gallery });
