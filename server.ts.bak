    if (!Array.isArray(data.gallery)) data.gallery = [];

    const photoId = newPhoto.photoId || `GAL-${Date.now()}`;
    const fullPhoto = {
      ...newPhoto,
      photoId,
      uploadedDate: newPhoto.uploadedDate || new Date().toISOString().split('T')[0],
    };

