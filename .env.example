# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APP_ENV: Deployment environment ('development' | 'staging' | 'production').
# In non-production, writes to the production Firestore database are strictly rejected.
APP_ENV="development"

# SESSION_SECRET: Cryptographic secret key used to sign and verify HMAC-SHA256 bearer tokens.
# Required for consistent stateless session validation across multiple Cloud Run container instances.
SESSION_SECRET="your-strong-cryptographic-session-secret-here"

# FIREBASE CONFIGURATION OVERRIDES:
# Set these to point the application to explicit Firebase projects and Firestore database instances.
FIREBASE_PROJECT_ID="iron-mender-0t8c4"
FIRESTORE_DATABASE_ID="ai-studio-omphchoir-7ac6c245-7aa6-4d84-950a-a615fe2ae522"

# STAGING FIREBASE CREDENTIALS (REQUIRED when APP_ENV is 'development' or 'staging'):
# Staging is strictly FAIL-CLOSED: if any of these 4 variables are missing in non-production,
# the application halts startup with HTTP 503 and refuses any database or application operations.
# Fallback to production credentials (iron-mender-0t8c4) is strictly prohibited.
STAGING_FIREBASE_PROJECT_ID="omph-choir-staging"
STAGING_FIRESTORE_DATABASE_ID="(default)"
STAGING_FIREBASE_API_KEY="AIzaSy..."
STAGING_FIREBASE_APP_ID="1:...:web:..."

# DOCUMENT SIZE SAFETY THRESHOLDS (bytes):
# Warns at 750 KiB (768,000 bytes) and hard rejects at 850 KiB (870,400 bytes) to prevent exceeding Firestore 1MB limit.
WARN_DOC_SIZE_BYTES="768000"
MAX_DOC_SIZE_BYTES="870400"
